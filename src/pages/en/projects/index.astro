---
// Projects listing (/projects/). Thin route shell: owns BaseLayout + SEO and composes the Figma
// "project-log-overview" frame (node 72:7) — the ProjectsHero panel + the shared CardGrid, fed from
// the `projects` collection (sorted by `order`, drafts dropped). Same `.site-container` shell/rhythm
// as index.astro & about.astro. This is the page the header nav's PROJECTS link points at.
import CardGrid from "@components/Sections/Global/CardGrid.astro";
import ProjectsHero from "@components/Sections/Project/ProjectsHero.astro";
import { getSiteData } from "@config/i18n";
import { getLangFromUrl } from "@js/i18n";
import { toProjectCard } from "@js/projectCards";
import { getSortedProjects } from "@js/projectData";
import BaseLayout from "@layouts/BaseLayout.astro";

const lang = getLangFromUrl(Astro.url);
const siteData = getSiteData(lang);
const cards = (await getSortedProjects(lang)).map((entry) => toProjectCard(entry, lang));
const copy = {
  es: {
    title: `Registro de proyectos — ${siteData.name}`,
    description:
      "El archivo de misiones: builds full-stack, migraciones y prototipos de terminal — cada módulo catalogado con su stack, estado y notas.",
    heading: "Todos los sistemas",
  },
  en: {
    title: `Project Log — ${siteData.name}`,
    description:
      "The quest archive: full-stack builds, migrations, and terminal prototypes — every module cataloged with its stack, status, and source notes.",
    heading: "All Systems",
  },
}[lang];
---

<BaseLayout
  title={copy.title}
  description={copy.description}
>
  <div class="site-container flex flex-col gap-10 py-8 md:gap-12 md:py-12">
    <ProjectsHero />
    <CardGrid headingId="all-systems-heading" title={copy.heading} items={cards} />
  </div>
</BaseLayout>
