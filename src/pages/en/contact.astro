---
// Contact (/contact/). Figma "contact-page" frame (node 9:4). Thin route shell: owns BaseLayout +
// SEO and composes the Sections/Contact blocks in the same shell as index/about (one .site-container
// + gap rhythm).
//
// Prerendered like every other route: the site is fully static and the form composes a `mailto:`
// in the browser (see Sections/Contact/Form.astro), so there is no server route to opt out of.
import Faq from "@components/Sections/Contact/Faq.astro";
import Form from "@components/Sections/Contact/Form.astro";
import Hero from "@components/Sections/Contact/Hero.astro";
import InfoCards from "@components/Sections/Contact/InfoCards.astro";
import { getSiteData } from "@config/i18n";
import { getLangFromUrl } from "@js/i18n";
import BaseLayout from "@layouts/BaseLayout.astro";

const lang = getLangFromUrl(Astro.url);
const siteData = getSiteData(lang);
const copy = {
  es: {
    title: `Contacto — ${siteData.name}`,
    description:
      "Envíame una transmisión: dudas de hardware retro, una colaboración o una propuesta de devlog, además de correo, Discord y GitHub y una FAQ del sistema.",
  },
  en: {
    title: `Contact — ${siteData.name}`,
    description:
      "Drop me a transmission — questions on vintage hardware, a retro-quest collab, or a guest devlog pitch — plus e-mail, Discord and GitHub links and a system FAQ.",
  },
}[lang];
---

<BaseLayout title={copy.title} description={copy.description}>  <div class="site-container flex flex-col gap-10 py-8 md:gap-12 md:py-12">
    <Hero />

    {/* Figma FormAndInfoContainer: form grows, info column is a fixed 340px — stacks below lg. */}
    <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_340px]">
      <Form />
      <InfoCards />
    </div>

    <Faq />
  </div>
</BaseLayout>
