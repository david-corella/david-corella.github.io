---
// About (/about/). Thin route shell: owns BaseLayout + SEO and composes the Figma "Pixel Quests -
// About Me" frame (node 5:278) from Sections/About. One shared `.site-container` wraps every section
// (aligned with the header/footer); `gap-*` gives the vertical rhythm — the same shell as index.astro.
import DevProfile from "@components/Sections/About/DevProfile.astro";
import Education from "@components/Sections/About/Education.astro";
import Gear from "@components/Sections/About/Gear.astro";
import Hero from "@components/Sections/About/Hero.astro";
import SkillTree from "@components/Sections/About/SkillTree.astro";
import { getSiteData } from "@config/i18n";
import { getLangFromUrl } from "@js/i18n";
import BaseLayout from "@layouts/BaseLayout.astro";

const lang = getLangFromUrl(Astro.url);
const siteData = getSiteData(lang);
const copy = {
  es: {
    title: `Sobre mí — ${siteData.name}`,
    description:
      "El perfil: proyectos, stack tecnológico, logros desbloqueados y mi equipo de trabajo — todo en 8-bit.",
  },
  en: {
    title: `About — ${siteData.name}`,
    description:
      "The dev profile: a full-stack developer's project log, tech stack, unlocked achievements, and daily-driver setup — all in 8-bit.",
  },
}[lang];
---

<BaseLayout
  title={copy.title}
  description={copy.description}
>
  <div class="site-container flex flex-col gap-10 py-8 md:gap-12 md:py-12">
    <Hero />
    <DevProfile />
    <SkillTree />
    <Education />
    <Gear />
  </div>
</BaseLayout>
