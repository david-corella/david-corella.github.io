---
// Blog listing (/blog/). Thin route shell: owns BaseLayout + SEO and composes the Figma
// "blog-listing-page" frame (node 76:4) — the BlogHero panel + the shared CardGrid, fed from the
// `blog` collection (newest first, drafts dropped). Same `.site-container` shell/rhythm as the other
// pages. This is the page the header nav's BLOG link points at.
import BlogHero from "@components/Sections/Blog/BlogHero.astro";
import CardGrid from "@components/Sections/Global/CardGrid.astro";
import { getSiteData } from "@config/i18n";
import { getSortedPosts } from "@js/blogData";
import { getLangFromUrl } from "@js/i18n";
import { toPostCard } from "@js/postCards";
import BaseLayout from "@layouts/BaseLayout.astro";

const lang = getLangFromUrl(Astro.url);
const siteData = getSiteData(lang);
const cards = (await getSortedPosts(lang)).map((entry) => toPostCard(entry, lang));
const copy = {
  es: {
    title: `Últimas entradas — ${siteData.name}`,
    description:
      "Despachos de desarrollo: notas de campo desde la frontera del código, arquitecturas retro y proyectos full-stack poco convencionales.",
    heading: "Módulos del archivo",
  },
  en: {
    title: `Latest Posts — ${siteData.name}`,
    description:
      "Dev Dispatches — field notes from the code frontier: web operations, vintage architectures, and unconventional full-stack builds, cataloged as retro archive modules.",
    heading: "Archive Modules",
  },
}[lang];
---

<BaseLayout
  title={copy.title}
  description={copy.description}
>
  <div class="site-container flex flex-col gap-10 py-8 md:gap-12 md:py-12">
    <BlogHero />
    <CardGrid headingId="archive-modules-heading" title={copy.heading} items={cards} />
  </div>
</BaseLayout>
