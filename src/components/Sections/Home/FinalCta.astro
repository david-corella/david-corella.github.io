---
// src/components/Sections/Home/FinalCta.astro — the home page's closing call-to-action row
// ("Leer blog" / "Saluda"), moved here from the hero so the hero leads straight into About.
import { getLangFromUrl, localizePath } from "@js/i18n";

const lang = getLangFromUrl(Astro.url);
const copy = {
  es: { blog: "Leer blog", sayHi: "Saluda" },
  en: { blog: "Read Blog", sayHi: "Say Hi" },
}[lang];
---

<div class="flex flex-col gap-4 pt-2 sm:flex-row sm:justify-center">
  <a
    href={localizePath("/blog/", lang)}
    class="pixel-btn pixel-btn--blue px-5 py-4 text-sm uppercase sm:text-base"
  >
    {copy.blog}
  </a>
  <a
    href={localizePath("/contact/", lang)}
    class="pixel-btn px-5 py-4 text-sm uppercase sm:text-base"
  >
    {copy.sayHi}
  </a>
</div>
