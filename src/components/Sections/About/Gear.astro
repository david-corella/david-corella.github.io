---
// src/components/Sections/About/Gear.astro — Figma "Equipment Section" (node 25:215).
//
// Section heading + a single pixel card holding a five-row spec list (EDITOR / TERMINAL / MONITOR /
// KEYBOARD / FUEL). The same label→value row as the Dev Profile card, so it's a plain <dl>. Below
// the fold → <Reveal>. Tokens only.
//
// CONTENT: the mock's demo gear (retro flavour, typed local) — swap for a real setup.
import SectionHeading from "@components/Sections/Global/SectionHeading.astro";
import { PixelPanel } from "@components/ui/pixel-panel";
import { Reveal } from "@components/ui/reveal";
import { getLangFromUrl } from "@js/i18n";

const lang = getLangFromUrl(Astro.url);

// Bilingual section copy — the heading and the five label/value gear rows.
const copy = {
  es: {
    heading: "Equipo / Setup",
    editor: "Editor",
    editorValue: "VS Code",
    terminal: "Terminal",
    terminalValue: "Zsh + Tmux",
    monitor: "Monitor",
    monitorValue: "Ultra ancho 4K",
    keyboard: "Teclado",
    keyboardValue: "Teclado mecánico",
    fuel: "Combustible",
    fuelValue: "Café negro",
  },
  en: {
    heading: "Setup / Gear",
    editor: "Editor",
    editorValue: "VS Code",
    terminal: "Terminal",
    terminalValue: "Zsh + Tmux",
    monitor: "Monitor",
    monitorValue: "Ultrawide 4K",
    keyboard: "Keyboard",
    keyboardValue: "Mechanical KB",
    fuel: "Fuel",
    fuelValue: "Black Coffee",
  },
}[lang];

const gear = [
  { label: copy.editor, value: copy.editorValue },
  { label: copy.terminal, value: copy.terminalValue },
  { label: copy.monitor, value: copy.monitorValue },
  { label: copy.keyboard, value: copy.keyboardValue },
  { label: copy.fuel, value: copy.fuelValue },
] as const;
---

<Reveal as="section" aria-labelledby="gear-heading" class="flex flex-col gap-6">
  <SectionHeading id="gear-heading" title={copy.heading} />

  <PixelPanel as="dl" class="flex flex-col gap-3 p-5 sm:p-6">
    {
      gear.map((row) => (
        <div class="flex items-center justify-between gap-4 text-xs font-bold uppercase sm:text-sm">
          <dt class="text-info">{row.label}:</dt>
          <dd class="text-foreground">{row.value}</dd>
        </div>
      ))
    }
  </PixelPanel>
</Reveal>
