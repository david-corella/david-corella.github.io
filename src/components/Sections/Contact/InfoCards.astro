---
// src/components/Sections/Contact/InfoCards.astro — Figma "InfoCardsContainer" (node 9:53).
//
// Pixel info cards beside the form: a retro tag, a title, a one-line blurb, and a linked value box.
// The value box is a real <a> that goes green on hover. Tokens only.
//
// WIRING: the E-MAIL value is `siteData.author.email` (→ mailto); GITHUB, LINKEDIN and INSTAGRAM
// resolve through `@config/socialData`, which owns the `sameAs` derivation every section shares.
import type { BadgeVariant } from "@components/ui/badge";
import { Badge } from "@components/ui/badge";
import { PixelPanel } from "@components/ui/pixel-panel";
import { getSiteData } from "@config/i18n";
import { socialHref } from "@config/socialData.json";
import { getLangFromUrl } from "@js/i18n";

const lang = getLangFromUrl(Astro.url);
const siteData = getSiteData(lang);
const email = siteData.author.email;
const github = socialHref("github", lang);
const linkedin = socialHref("linkedin", lang);
const instagram = socialHref("instagram", lang);

const copy = {
  es: {
    emailTag: "Correo",
    emailTitle: "Telepatía",
    emailBlurb: "Enlace digital directo a mi buzón",
    githubTag: "Código",
    githubTitle: "Hub de GitHub",
    githubBlurb: "Explora mis repositorios de código",
    linkedinTag: "Profesional",
    linkedinTitle: "LinkedIn",
    linkedinBlurb: "Mi trayectoria y red profesional",
    instagramTag: "Social",
    instagramTitle: "Instagram",
    instagramBlurb: "Un vistazo a mi día a día",
  },
  en: {
    emailTag: "E-Mail",
    emailTitle: "Telepathy",
    emailBlurb: "Direct digital link to my HQ mailbox",
    githubTag: "Codebase",
    githubTitle: "GitHub Hub",
    githubBlurb: "Explore my code repositories",
    linkedinTag: "Professional",
    linkedinTitle: "LinkedIn",
    linkedinBlurb: "My track record and professional network",
    instagramTag: "Social",
    instagramTitle: "Instagram",
    instagramBlurb: "A glimpse into my day-to-day",
  },
}[lang];

/** Strip scheme + trailing slash for the displayed value (the box still links to the full URL). */
const display = (url: string): string => url.replace(/^https?:\/\//, "").replace(/\/$/, "");

const cards: readonly {
  tag: string;
  tone: BadgeVariant;
  title: string;
  blurb: string;
  value: string;
  href: string;
}[] = [
  {
    tag: copy.emailTag,
    tone: "info",
    title: copy.emailTitle,
    blurb: copy.emailBlurb,
    value: email,
    href: `mailto:${email}`,
  },
  {
    tag: copy.githubTag,
    tone: "secondary",
    title: copy.githubTitle,
    blurb: copy.githubBlurb,
    value: display(github),
    href: github,
  },
  {
    tag: copy.linkedinTag,
    tone: "primary",
    title: copy.linkedinTitle,
    blurb: copy.linkedinBlurb,
    value: display(linkedin),
    href: linkedin,
  },
  {
    tag: copy.instagramTag,
    tone: "success",
    title: copy.instagramTitle,
    blurb: copy.instagramBlurb,
    value: display(instagram),
    href: instagram,
  },
];
---

<div class="flex flex-col gap-6">
  {
    cards.map((card) => (
      <PixelPanel class="flex flex-col items-start gap-4 p-6">
        <Badge pixel variant={card.tone}>
          {card.tag}
        </Badge>
        <h2 class="h3 text-foreground">{card.title}</h2>
        <p class="text-muted-foreground text-xs">{card.blurb}</p>
        <a
          href={card.href}
          class="bg-accent border-border text-info hover:text-success primary-focus block w-full truncate border-2 p-3 text-sm uppercase transition-colors"
        >
          {card.value}
        </a>
      </PixelPanel>
    ))
  }
</div>
