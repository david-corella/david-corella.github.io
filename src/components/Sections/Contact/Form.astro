---
// src/components/Sections/Contact/Form.astro — Figma "ContactFormCard" (node 9:31).
//
// Static contact form: the site is hosted on GitHub Pages, which cannot run server code, so the
// form does NOT post to a backend. On submit, a small bundled script composes a `mailto:` URL from
// the field values and hands it to the visitor's mail client (see the <script> below). Native HTML5
// validation (required / type=email / minlength / maxlength) does the checking before that.
//
// Reuse: the shared pixel surface (PixelPanel) + the Input / Textarea / Label primitives, re-skinned
// to the pixel field look (bg-accent + a 4px black frame) via a shared class. The override carries
// SHAPE only, never a border COLOUR (borders are always black in the theme).
import { Badge } from "@components/ui/badge";
import { Input } from "@components/ui/input";
import { Label } from "@components/ui/label";
import { PixelPanel } from "@components/ui/pixel-panel";
import { Textarea } from "@components/ui/textarea";
import { getSiteData } from "@config/i18n";
import { getLangFromUrl } from "@js/i18n";

const lang = getLangFromUrl(Astro.url);
const siteData = getSiteData(lang);

// Where the composed mail is addressed, and the brand used in the subject line. Static (build-time)
// values, surfaced to the script through data-* attributes so the script stays bundled, not inlined.
const contactTo = siteData.author.email;
const brand = siteData.name;

const copy = {
  es: {
    title: "Enviar Mensaje",
    successBadge: "Transmisión Encolada",
    successBody:
      "Tu cliente de correo debería estar abierto con el mensaje pre-rellenado — solo pulsa enviar.",
    submit: "Enviar Mensaje",
    name: { label: "Tu Nombre", placeholder: "p. ej. JUGADOR UNO" },
    email: { label: "Correo Electrónico", placeholder: "p. ej. JUGADOR1@EJEMPLO.COM" },
    subject: { label: "Asunto", placeholder: "p. ej. CONSULTA DE TUTORIAL" },
    message: { label: "Transmisión de Mensaje", placeholder: "ESCRIBE TU TRANSMISIÓN AQUÍ..." },
  },
  en: {
    title: "Send Message",
    successBadge: "Transmission Queued",
    successBody: "Your mail app should now be open with the message pre-filled — just hit send.",
    submit: "Send Message",
    name: { label: "Your Name", placeholder: "e.g. PLAYER ONE" },
    email: { label: "Email Address", placeholder: "e.g. PLAYER1@EXAMPLE.COM" },
    subject: { label: "Subject", placeholder: "e.g. TUTORIAL INQUIRY" },
    message: { label: "Message Transmission", placeholder: "TYPE YOUR TRANSMISSION HERE..." },
  },
}[lang];

const FIELDS = [
  { name: "name", ...copy.name, as: "input", type: "text", autocomplete: "name", maxlength: 100 },
  {
    name: "email",
    ...copy.email,
    as: "input",
    type: "email",
    autocomplete: "email",
    maxlength: 254,
  },
  {
    name: "subject",
    ...copy.subject,
    as: "input",
    type: "text",
    autocomplete: "off",
    maxlength: 150,
  },
  { name: "message", ...copy.message, as: "textarea", autocomplete: "off", maxlength: 5000 },
] as const;

// SHAPE only: the pixel field surface + focus/invalid rings. No border colour.
const fieldClass = [
  "bg-accent border-border rounded-none border-4 px-4 text-sm placeholder:text-muted-foreground",
  "aria-[invalid=true]:ring-3 aria-[invalid=true]:ring-error/60",
].join(" ");
---

<PixelPanel elevated class="flex flex-col gap-6 p-6 sm:p-8">
  <h2 class="text-secondary-700 dark:text-secondary font-display text-base uppercase sm:text-lg">
    {copy.title}
  </h2>

  <div
    id="contact-success"
    role="status"
    tabindex="-1"
    hidden
    class="flex flex-col items-start gap-3"
  >
    <Badge pixel variant="success">
      {copy.successBadge}
    </Badge>
    <p class="text-muted-foreground text-sm">
      {copy.successBody}
    </p>
  </div>

  <form
    id="contact-form"
    data-contact-to={contactTo}
    data-brand={brand}
    class="flex flex-col gap-4"
  >
    {
      FIELDS.map((field) => (
        <div class="flex flex-col gap-2">
          <Label for={field.name} class="text-info font-display text-xs uppercase">
            {field.label}
          </Label>
          {field.as === "textarea" ? (
            <Textarea
              id={field.name}
              name={field.name}
              placeholder={field.placeholder}
              autocomplete={field.autocomplete}
              required
              maxlength={field.maxlength}
              minlength={10}
              class={`${fieldClass} min-h-[120px] py-3`}
            />
          ) : (
            <Input
              id={field.name}
              name={field.name}
              type={field.type}
              placeholder={field.placeholder}
              autocomplete={field.autocomplete}
              required
              maxlength={field.maxlength}
              class={`${fieldClass} h-14`}
            />
          )}
        </div>
      ))
    }

    <button
      type="submit"
      class="pixel-btn pixel-btn--green mt-2 self-start px-6 py-3 text-sm uppercase sm:text-base"
    >
      {copy.submit}
    </button>
  </form>
</PixelPanel>

<script>
  // Compose a mailto: from the form and hand it to the visitor's mail client. Idempotent: assigning
  // onsubmit (not addEventListener) means re-running after a view-transition swap never double-binds.
  function initContactForm() {
    const form = document.getElementById("contact-form");
    if (!(form instanceof HTMLFormElement)) return;

    form.onsubmit = (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const read = (key: string): string => String(data.get(key) ?? "").trim();

      const name = read("name");
      const sender = read("email");
      const subject = read("subject");
      const message = read("message");
      const to = form.dataset.contactTo ?? "";
      const brand = form.dataset.brand ?? "";

      const mailSubject = `[${brand}] ${subject} — ${name}`;
      const body = `Name: ${name}\nEmail: ${sender}\n\n${message}`;
      const href = `mailto:${to}?subject=${encodeURIComponent(mailSubject)}&body=${encodeURIComponent(body)}`;

      window.location.href = href;

      const success = document.getElementById("contact-success");
      if (success instanceof HTMLElement) {
        success.hidden = false;
        success.focus();
      }
    };
  }

  document.addEventListener("astro:page-load", initContactForm);
</script>
